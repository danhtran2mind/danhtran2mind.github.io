{% assign cv = site.data.my_resume %}
{% assign config = page.cv %}

<!-- Resume Function -->
<script>
/* ---------- PRINT (browser dialog) ---------- */
    function printDiv() {
        window.print();
    }

/* ---------- DOWNLOAD PDF directly ---------- */
    function downloadDiv() {
        const pdfUrl = '/assets/pdf/resume/RESUME _ Danh Tran.pdf';
        const link = document.createElement('a');
        link.href = pdfUrl;
        link.download = 'RESUME_Danh_Tran.pdf';
        link.style.display = 'none';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>

<div class="cv" style="max-width: 900px; margin: 0 auto; background-color: var(--cv-background);">
    <!-- generated by Kamila's YAML CV: https://github.com/anotherkamila/yamlCV -->
    <style scoped>
        :root {
            --cv-font-family: "Libertinus Serif", "Times New Roman", Georgia, serif;
            --cv-accent-color: #1e40af;
            --cv-text-color: #1f2937;
            --cv-muted-color: #6b7280;
            --cv-background: #ffffff;
            --cv-border: #e2e8f0;
            --cv-link-color: #1e40af;
            --cv-accent-bg: #ffffff;
            --cv-muted-bg: #f8f9fa;
            --cv-zebra-bg-odd: #f5f7fa;
            --cv-zebra-bg-even: #e2e8f0;
            --cv-column-1-bg: #f8fafc;
            --cv-column-2-bg: #e2e8f0;
            --cv-column-3-bg: #dbeafe;
        }
        [data-theme="light"] {
            --cv-text-color: #1f2937;
            --cv-muted-color: #6b7280;
            --cv-background: #ffffff;
            --cv-border: #e2e8f0;
            --cv-accent-color: #1e40af;
            --cv-link-color: #1e40af;
            --cv-accent-bg: #ffffff;
            --cv-muted-bg: #f8f9fa;
            --cv-zebra-bg-odd: #ffffff;
            --cv-zebra-bg-even: #f1f3f5;
            --cv-column-1-bg: #f8fafc;
            --cv-column-2-bg: #e2e8f0;
            --cv-column-3-bg: #dbeafe;
        }
        [data-theme="dark"] {
            --cv-text-color: #f0f0f0;
            --cv-muted-color: #a0a0a0;
            --cv-background: #1a1a1a;
            --cv-border: #4b5563;
            --cv-accent-color: #60a5fa;
            --cv-link-color: #90cdf4;
            --cv-accent-bg: #1a1a1a;
            --cv-muted-bg: #2a2a2a;
            --cv-zebra-bg-odd: #2f343a;
            --cv-zebra-bg-even: #3c4248;
            --cv-column-1-bg: #1e293b;
            --cv-column-2-bg: #334155;
            --cv-column-3-bg: #3b4a6b;
        }

        .cv {
            font-family: var(--cv-font-family);
            color: var(--cv-text-color);
            line-height: 1.5;
            background-color: var(--cv-background);
        }
        .cv p { margin: 0; }
        .cv h1, .cv h2 { font-weight: normal; }
        .cv-photo {
            height: 150px;
            width: 150px;
            margin: 0 1.5em 1.5em 0;
            float: left;
            border-radius: 50%;
            border: 2px solid var(--cv-border);
            object-fit: cover;
        }
        .cv-name {
            font-size: clamp(1.75em, calc(1.75em + 0.6vw), 2.1em);
            line-height: 1.2;
            margin: 0.5em 0;
            text-align: left;
            color: var(--cv-accent-color);
            background-color: var(--cv-accent-bg);
        }
        .name-slogan {
            margin-left: 1em; 
            margin-right: 1em; 
            margin-bottom: 1em;
            overflow: hidden; /* Clears float */
        }
        .cv-basic-info-item {
            margin-right: 1.5em;
            white-space: nowrap;
        }
        .cv-basic-info {
            clear: both;
            text-align: center;
            font-size: clamp(0.8em, calc(0.8em + 0.2vw), 0.95em);
            margin-bottom: 1rem !important;
        }
        .cv-section {
            padding-top: 0rem !important;
            border-top: 0rem !important;
            margin-top: 0rem !important;
            margin-bottom: 0.25em !important;
            margin-right: 1em !important;
            margin-left: 1em !important;
        }
        .cv-section-title {
            font-size: clamp(1.2rem, calc(1.2rem + 0.4vw), 1.5rem);
            margin: 2em 0 1em 0;
            color: var(--cv-accent-color);
            background-color: var(--cv-accent-bg);
            margin-bottom: 0.1rem !important;
            margin-top: 0.1rem !important;
            padding: 0em 0em !important;
            font-style: italic;
        }
        .cv-item-title {
            font-weight: 600;
            font-size: clamp(0.95em, calc(0.95em + 0.25vw), 1.05em);
        }
        .cv-item {
            break-inside: avoid;
            page-break-inside: avoid;
            margin-bottom: 0.3rem;
        }
        .cv-item-content {
            padding-left: 0px !important;
            font-size: clamp(0.86em, calc(0.86em + 0.2vw), 0.95em);
            text-align: left;
            display: block;
            margin-top: 0em !important;
            margin-bottom: 0em !important;
        }
        .cv-item-content > ul {
            padding: 0 0 0 1.5em;
            margin: 0.5em 0;
        }
        
        .cv-item-row {
            font-size: clamp(0.9em, calc(0.9em + 0.4vw), 1.05em);
            margin-bottom: 0em;
            display: flex;
            flex-wrap: wrap;
            gap: 0.3em;
            align-items: center;
            justify-content: space-between;
            font-weight: 700;
        }
        .cv-item-row a {
            color: var(--cv-link-color);
            text-decoration: none;
        }
        .cv-item-row a:hover {
            text-decoration: underline;
        }
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 0.5em;
        }
        .two-column-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 0.5em;
        }
        .three-column-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 0.5em;
        }
        .two-column-section .cv-item:nth-child(4n-3), .two-column-section .cv-item:nth-child(4n) {
            background-color: var(--cv-zebra-bg-odd);
        }
        .two-column-section .cv-item:nth-child(4n-2), .two-column-section .cv-item:nth-child(4n-1) {
            background-color: var(--cv-zebra-bg-even);
        }
        .three-column-section .cv-item:nth-child(9n+1),
        .three-column-section .cv-item:nth-child(9n+6),
        .three-column-section .cv-item:nth-child(9n+8) {
            background-color: var(--cv-column-1-bg);
        }
        .three-column-section .cv-item:nth-child(9n+2),
        .three-column-section .cv-item:nth-child(9n+4),
        .three-column-section .cv-item:nth-child(9n+9) {
            background-color: var(--cv-column-2-bg);
        }
        .three-column-section .cv-item:nth-child(9n+3),
        .three-column-section .cv-item:nth-child(9n+5),
        .three-column-section .cv-item:nth-child(9n+7) {
            background-color: var(--cv-column-3-bg);
        }
        {% unless config.no_lines %}
        .cv-section-header { position: relative; }
        .cv-section-title { display: inline-block; background: var(--cv-accent-bg) !important; padding-right: 1.5em; }
        .cv-section-title:after {
            position: absolute;
            top: 50%;
            z-index: -1;
            content: '';
            display: block;
            width: 100%;
            border-top: 2px solid var(--cv-accent-color);
        }
        {% endunless %}
        .cv-section:not(:first-child) {
            margin-top: 2.5em;
            padding-top: 2.5em;
            border-top: 1px solid var(--cv-border);
        }
        .text-muted {
            color: var(--cv-muted-color) !important;
            background-color: var(--cv-muted-bg) !important;
            opacity: 1;
            font-style: italic;
        }
        .cv ul { margin: 0.5em 0; }
        .cv-basic-info-item a[href]:after { content: none !important; }
        .contact {
            white-space: nowrap;
            font-size: clamp(0.8em, calc(0.8em + 0.2vw), 0.95em);
            color: var(--cv-link-color);
        }
        .contact-block {
            display: inline-flex;
            align-items: center;
            gap: 0.5em;
            white-space: nowrap;
        }
        .cv-item:nth-child(odd) {
            background-color: var(--cv-zebra-bg-odd);
        }
        .cv-item:nth-child(even) {
            background-color: var(--cv-zebra-bg-even);
        }
        .university-name {
            font-size: 0.95rem;
            font-weight: 700;
        }
        .thesis-name {
            font-size: 0.95rem;
            font-weight: 700;
        }

        /* === MORE INFO COLUMNS === */
        .more-info-wrapper {
            display: flex;
            gap: 0.5rem;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        .more-info-column {
            flex: 1;
            min-width: 280px;
            box-sizing: border-box;
            padding: 0.5rem;
            border-radius: 8px;
        }
        .cv-item-row.more-info {
            display: flex;
            justify-content: space-between;
            line-height: 1.2;
            gap: 0.3rem;
            align-items: center;
        }
        .cv-item-title {
            font-weight: 600;
            white-space: nowrap;
        }
        .cv-item-title a {
            color: var(--cv-accent-color);
            text-decoration: none;
            margin-left: 0.15em;
        }
        .cv-item-title a:hover {
            text-decoration: underline;
        }
        /* === END MORE INFO === */

        /* === CHROME & FIREFOX UNIFIED PRINT STYLES === */
        @page { 
            size: A4; 
            margin: 0; 
        }
        @media print {
            /* Hide everything except the resume container */
            body > *:not(.cv) {
                display: none !important;
            }
            body {
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .cv {
                visibility: visible !important;
                position: relative !important; /* Fixed: Changed from absolute to prevent Chrome scaling/margin bugs */
                top: auto !important;
                left: auto !important;
                transform: none !important;
                width: 210mm !important;
                min-height: 297mm !important;
                margin: 0 auto !important;
                padding: 15mm !important; /* Consistent margins on all sides */
                background: #fff !important;
                font-size: 10pt !important;
                line-height: 1.4 !important;
                color: #000 !important;
                box-sizing: border-box !important;
            }
            .cv * {
                visibility: visible !important;
            }
            
            /* Header & Photo Alignment */
            .cv-photo { 
                height: 40mm !important; 
                width: 40mm !important; 
                float: left !important; 
                margin: 0 1rem 1rem 0 !important; 
                display: block !important; 
                border: 1px solid #000 !important; 
                border-radius: 50% !important;
                object-fit: cover !important;
            }
            .name-slogan { 
                margin-bottom: 1em !important; 
                overflow: hidden !important; /* Clears the float properly */
            }
            .cv-name { 
                font-size: 22pt !important; 
                margin-bottom: 0.5em !important; 
                color: #000 !important; 
                text-align: left !important;
            }
            .text-muted { 
                font-size: 10pt !important; 
                color: #666 !important; 
                display: block !important;
                clear: both !important;
            }
            
            /* Contact & Social Info Alignment */
            .contact-block > div {
                display: flex !important;
                flex-direction: row !important;
                justify-content: flex-start !important;
                align-items: center !important;
                gap: 0.5rem !important;
                flex-wrap: wrap !important;
            }
            .basic-info-div { 
                display: flex !important;
                flex-direction: row !important;
                justify-content: center !important;
                align-items: center !important;
                gap: 0.5em !important;
                flex-wrap: wrap !important;
                font-size: 9pt !important;
            }
            .contact, a.contact { 
                color: #000 !important; 
                font-size: 9pt !important; 
                text-decoration: none !important;
            }
            
            /* Sections & Items */
            .cv-section-title { 
                font-size: 12pt !important; 
                color: #1e40af !important; 
                margin-top: 1em !important;
                margin-bottom: 0.5em !important;
            }
            .cv-section:not(:first-child) { 
                border-top: 1px solid #000 !important; 
                padding-top: 1em !important;
                margin-top: 1em !important;
            }
            .cv-item { 
                margin-bottom: 0.5rem !important; 
                break-inside: avoid !important; 
                page-break-inside: avoid !important;
            }
            
            /* Experience Section Specifics */
            .experience .cv-item-row {
                display: flex !important;
                flex-wrap: nowrap !important;
                align-items: center !important;
                justify-content: space-between !important;
                gap: 0 !important;
            }
            .experience .cv-item-row > div:nth-child(1) { width: 30% !important; text-align: left !important; }
            .experience .cv-item-row > div:nth-child(2) { width: 50% !important; text-align: center !important; }
            .experience .cv-item-row > div:nth-child(3) { width: 20% !important; text-align: right !important; }
            
            .experience-description-list { 
                display: grid !important; 
                grid-template-columns: 1fr 1fr !important; 
                gap: 0.25rem 1rem !important; 
                padding-left: 1.1rem !important; 
                margin: 0.2rem 0 0 0 !important; 
                list-style: disc !important; 
            }
            .experience-description-list li { 
                margin: 0 !important; 
                padding-left: 0.15rem !important; 
                line-height: 1.3 !important; 
                font-size: 9pt !important;
            }
            
            /* Grids (Skills, Projects, Certificates) */
            .skills-grid, .two-column-section, .three-column-section { 
                display: grid !important;
                gap: 0.5rem !important;
            }
            .skills-grid.three-column-section,
            .three-column-section {
                grid-template-columns: repeat(3, 1fr) !important;
            }
            .two-column-section { 
                grid-template-columns: repeat(2, 1fr) !important; 
            }
            
            /* More Info Section */
            .more-info-wrapper {
                display: flex !important;
                gap: 1rem !important;
                justify-content: space-between !important;
                flex-wrap: wrap !important;
                margin-top: 1rem !important;
            }
            .more-info-column {
                flex: 1 !important;
                min-width: 250px !important;
                box-sizing: border-box !important;
            }
            .cv-item-row.more-info {
                display: flex !important;
                justify-content: space-between !important;
                align-items: center !important;
                gap: 0.5rem !important;
            }
            
            /* General Print Fixes */
            .cv a[href]:after { 
                content: none !important; 
            }
            .cv-item:nth-child(odd), .cv-item:nth-child(even),
            .two-column-section .cv-item, .three-column-section .cv-item { 
                -webkit-print-color-adjust: exact !important; 
                print-color-adjust: exact !important; 
            }
            .cv-item-content {
                font-size: 9pt !important;
                line-height: 1.3 !important;
            }
        }
    </style>

    <!-- Name and Avatar -->
    <header class="name-slogan">
        <img class="cv-photo" src="{{cv.photo}}" alt="my photo"/>
        <h1 class="cv-name">{{cv.name}}</h1>
        <span class="text-muted">{{cv.tagline}}</span>
    </header>

    <!-- Basic Info -->
    <header class="contact-block" style="border-bottom-width: 0em;">
        <div style="display: flex; flex-direction: row; justify-content: flex-start; align-items: center; gap: 0.5rem; flex-wrap: wrap; text-align: left;">
            {% if cv.date_of_birth %}
                <span class="contact-block" style="margin-left: 0em;">
                    <img src="{{ '/assets/svg/date_of_birth.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="date_of_birth icon"/>
                    <span class="contact">{{cv.date_of_birth | markdownify}}</span>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.location %}
                <span class="contact-block">
                    <img src="{{ '/assets/svg/location.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="location icon"/>
                    <span class="contact">{{cv.location}}</span>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.email %}
                <span class="contact-block">
                    <img src="{{ '/assets/svg/email.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="email icon"/>
                    <a class="contact" href="mailto:{{cv.email}}">{{cv.email}}</a>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.phone %}
                <span class="contact-block" style="margin-right: 0em;">
                    <img src="{{ '/assets/svg/phone.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="phone icon"/>
                    <a class="contact" href="tel:{{cv.phone}}">{{cv.phone}}</a>
                </span>
            {% endif %}
        </div>
    </header>

    <!-- Social Links -->
    <section class="cv-basic-info" style="display: flex; justify-content: center; margin: 0 1em 2em 1em;">
        <div class="basic-info-div" style="display: flex; flex-direction: row; justify-content: center; gap: 0.4em; flex-wrap: wrap; font-size: 0.84rem;">
            {% if cv.github %}
                <span class="contact-block" style="font-size: 0.84rem;">
                    <img src="{{ '/assets/svg/github.svg' | relative_url }}" style="width: 18px; height: 18px;" alt="github icon"/>
                    <a class="contact" href="{{cv.github}}" style="font-size: 0.84rem;">{{cv.github | replace: 'https://github.com/', ''}}</a>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.huggingface %}
                <span class="contact-block" style="font-size: 0.84rem;">
                    <img src="{{ '/assets/svg/huggingface.svg' | relative_url }}" style="width: 18px; height: 18px;" alt="huggingface icon"/>
                    <a class="contact" href="{{cv.huggingface}}" style="font-size: 0.84rem;">{{cv.huggingface | replace: 'https://huggingface.co/', ''}}</a>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.website %}
                <span class="contact-block" style="font-size: 0.84rem;">
                    <img src="{{ '/assets/svg/website.svg' | relative_url }}" style="width: 18px; height: 18px;" alt="website icon"/>
                    <a class="contact" href="{{cv.website}}" style="font-size: 0.84rem;">{{cv.website | replace: 'https://', ''}}</a>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.linkedin %}
                <span class="contact-block">
                    <img src="{{ '/assets/svg/linkedin.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="linkedin icon"/>
                    <a class="contact" href="{{cv.linkedin}}">{{cv.linkedin | replace: 'https://www.linkedin.com/in/', ''}}</a>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.x %}
                <span class="contact-block">
                    <img src="{{ '/assets/svg/x.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="x icon"/>
                    <a class="contact" href="{{cv.x}}">{{cv.x | replace: 'https://x.com/', ''}}</a>
                </span>
            {% endif %}
            <span>•</span>
            {% if cv.facebook %}
                <span class="contact-block">
                    <img src="{{ '/assets/svg/facebook.svg' | relative_url }}" style="width: 20px; height: 20px;" alt="facebook icon"/>
                    <a class="contact" href="{{cv.facebook}}">{{cv.facebook | replace: 'https://facebook.com/', ''}}</a>
                </span>
            {% endif %}
        </div>
    </section>

    <!-- Main Sections (excluding additional_info) -->
    {% for sec_id in cv.sections %}
        {% assign section = cv.data[sec_id] %}
        {% unless sec_id == 'additional_info' %}
        <section class="cv-section {% if sec_id == 'experience' %}experience{% endif %}" id="{{sec_id}}">
            <header class="cv-section-header">
                <h2 class="text-primary cv-section-title">{{section.title}}</h2>
            </header>

            {% if sec_id == 'education' %}
                {% for item in section.items %}
                    <div class="cv-item">
                        <div class="cv-item-row degree" style="font-size: 0.99rem;">
                            <div><span>{{item.degree}}</span></div>
                            {% if item.thesis %}<div><em>GPA:</em> <span>{{item.gpa}}</span></div>{% endif %}
                            <div><span>{{item.date | markdownify}}</span></div>
                        </div>
                        <div class="cv-item-content edu instustute" style="font-size: 0.99rem;">
                            <em>University:</em>
                            <span class="university-name">{{item.university | markdownify | strip_html}}</span>
                        </div>
                        {% if item.thesis %}
                            <div class="cv-item-content edu document" style="font-size: 0.99rem;">
                                <em>Thesis:</em>
                                <span class="thesis-name"><p style="display:inline;">{{item.thesis | strip_html}}</p></span>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}

            {% elsif sec_id == 'projects' %}
                <div class="three-column-section">
                    {% for item in section.items %}
                        <div class="cv-item">
                            <div class="cv-item-row two-columns" style="display: inline;">
                                <div class="cv-item-row-name project-name"><span>{{item.name}}</span></div>
                                <div class="project-date" style="display: flex; justify-content: space-between; font-size: 0.73rem !important;">
                                    <div class="project-url">
                                        {% if item.url %}
                                            {% if item.url contains 'github.com' %}
                                                <img src="{{ '/assets/svg/github.svg' | relative_url }}" style="width: 11px; height: 11px;" alt="GitHub icon"/>
                                                <a href="{{ item.url }}">{{ item.url | replace: 'https://github.com/', '' }}</a>
                                            {% elsif item.url contains 'huggingface.co' %}
                                                <img src="{{ '/assets/svg/huggingface.svg' | relative_url }}" style="width: 11px; height: 11px;" alt="Hugging Face icon"/>
                                                <a href="{{ item.url }}">{{ item.url | replace: 'https://huggingface.co/', '' }}</a>
                                            {% else %}<span></span>{% endif %}
                                        {% else %}<span></span>{% endif %}
                                    </div>
                                    <div><span>{{item.date | markdownify}}</span></div>
                                </div>
                            </div>
                            {% if item.description %}
                                <div class="cv-item-content about">
                                    <span style="font-style: italic;"><p style="display:inline;">{{item.description | markdownify | strip_html}}</p></span>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                <div class="cv-item-content more">
                    <em>For further details on additional projects, please refer to 
                        <a href="#more_information" style="color: var(--cv-accent-color); text-decoration: none; font-weight: 700;">More Information.</a>
                    </em>
                </div>

            {% elsif sec_id == 'certificates' %}
                <div class="three-column-section">
                    {% for item in section.items %}
                        <div class="cv-item">
                            <div class="cv-item-row two-columns" style="display: inline; line-height: 1.1rem;">
                                <div class="cv-item-row-name cert"><span>{{item.name}}</span></div>
                                <div class="cv-item-row two-columns issuer-date" style="display: flex;justify-content: space-between;">
                                    <div>
                                        {% if item.url %}
                                            <a href="{{ item.url }}" target="_blank" style="margin-right: 0.15rem;">{{ item.provider_issuer }}</a>
                                            <img src="/assets/svg/url.svg" style="width: 11px; height: 11px;" alt="url icon">
                                        {% else %}
                                            <span>{{ item.provider_issuer }}</span>
                                        {% endif %}
                                    </div>
                                    <div><span>{{item.date | markdownify}}</span></div>
                                </div>
                            </div>
                            <div class="cv-item-content about cert">
                                {% if item.description %}
                                    <p style="display:inline;">{{item.description | markdownify | strip_html}}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="cv-item-content more">
                    <em>For a detailed and comprehensive list of certificates, please consult the additional information provided in the
                        <a href="#more_information" style="color: var(--cv-accent-color); text-decoration: none; font-weight: 700;">More Information.</a>
                    </em>
                </div>

            {% elsif sec_id == 'experience' %}
                {% for item in section.items %}
                    <div class="cv-item">
                        <div class="cv-item-row" style="display: flex; justify-content: space-between; font-size: 0.99rem; line-height: 1.2;">
                            <div style="width: 30%;">{{item.job_title | markdownify}}</div>
                            <div style="width: 50%; text-align: center;">{{item.organization | markdownify}}</div>
                            <div style="width: 20%; text-align: right;">{{item.date | markdownify}}</div>
                        </div>
                        <div class="cv-item-content" style="line-height: 1.1;">
                            {% if item.description %}
                                {% assign description_text = item.description | strip | newline_to_br %}
                                {% assign description_parts = description_text | split: '<br />' %}
                                <div class="experience-description-label"><em>Description:</em></div>
                                <ul class="experience-description-list">
                                    {% for part in description_parts %}
                                        {% assign clean_part = part | strip %}
                                        {% if clean_part != '' %}
                                            <li>{{ clean_part | markdownify | strip_html }}</li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}

            {% elsif sec_id == 'skills' %}
                <div class="skills-grid three-column-section">
                    {% for group in section.items %}
                        <div class="cv-item">
                            <div class="cv-item-row"><span>{{ group.group_name }}</span></div>
                            <div class="cv-item-content">
                                {% for skill in group.group_name_elements %}
                                    {{ skill.element }}{% if forloop.last == false %}, {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

            {% endif %}
        </section>
        {% endunless %}
    {% endfor %}

    <!-- MORE INFORMATION & LANGUAGE CERTIFICATIONS -->
    {% assign more_info = cv.data.additional_info %}

    <div class="more-info-wrapper">
        <!-- RIGHT: More Information -->
        <section class="cv-section more-info-column" id="more_information" style="margin-left: 1rem !important; margin-right: 0rem !important; padding-left: 0px; padding-right: 0px; margin-bottom: 0px !important; padding-bottom: 0px;">
            <header class="cv-section-header">
                <h2 class="text-primary cv-section-title">{{ more_info.title }}</h2>
            </header>
            <div class="more-info-link">
                {% for item in more_info.items %}
                <div class="cv-item" style="margin-bottom: 0rem;">
                    <div class="cv-item-row more-info">
                        <div class="cv-item-title" style="text-align: right; padding-right: 0.1rem; margin-top: 0rem;">{{ item.name }}</div>
                        {% if item.url %}
                            <div class="cv-item-title more-info-link url" style="text-align: left; padding-left: 0.1rem; margin-top: 0rem;">
                                <a href="{{ item.url }}">{{ item.url | replace: 'https://', '' }}</a>
                            </div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>
    </div>
</div>